@using InstaLike.Web.Extensions

@model IEnumerable<CommentModel>

@{
    const int visibleComments = 5;
    var comments = Model?.ToList() ?? new List<CommentModel>();
}

@if (comments.Count > 0)
{
    <ol class="post-comments">
        @for (var i = 0; i < comments.Count; i++)
        {
            var comment = comments[i];
            <li class="@(i >= visibleComments ? "comment-hidden" : null)">
                <strong>
                    <a class="comment-author-nickname" asp-action="Profile" asp-controller="Member" asp-route-id="@comment.AuthorNickName">@comment.AuthorNickName</a>
                </strong>
                <p>
                    &nbsp;@comment.Text
                </p>
                <span>
                    &nbsp;<content-date value="@comment.CommentDate" />
                </span>
            </li>
        }
    </ol>

    @if (comments.Count > visibleComments)
    {
        <button type="button" class="show-all-comments" aria-expanded="false" data-show-label="Show all @comments.Count comments" data-hide-label="Show fewer comments">Show all @comments.Count comments</button>
    }
}
