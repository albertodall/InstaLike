@using InstaLike.Core.Notifications
@using InstaLike.Web.Extensions

@model IEnumerable<NotificationModel>

@{
    ViewBag.Title = "Notifications";
}

<div class="alerts">
    @if (Model.Any())
    {
        foreach (var notification in Model)
        {
            <div>
                @{
                    var senderProfilePicture = Url.ProfilePicture(notification.SenderProfilePicture);
                }
                <img src="@senderProfilePicture" alt="Sender's profile picture" />
                <a href="@Url.Action("Profile", "Account", new { @id = notification.SenderNickname})">
                    @notification.SenderNickname
                </a>
                <time title="@notification.NotificationDate.DateTime" datetime="@notification.NotificationDate.DateTime">@notification.NotificationDate.UtcDateTime.AsPastDays()</time>

                <p>
                    @switch (notification.Kind)
                    {
                        case NotificationKind.Followed:
                            <text>has started following you.</text>
                            break;
                        case NotificationKind.PostLiked:
                            <text>liked your <a href="@Url.Action("Detail", "Post", new { id = notification.PostID })">post</a>.</text>
                            break;
                        case NotificationKind.PostCommented:
                            <text>wrote a comment about your <a href="@Url.Action("Detail", "Post", new { id = notification.PostID })">post</a>.</text>
                            break;
                    }
                </p>
            </div>
        }
    }
    else
    {
        <div class="msg">There are no unread notifications.</div>
    }
</div>
