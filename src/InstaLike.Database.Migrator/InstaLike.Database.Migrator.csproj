<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="dbup-sqlserver" />
    <!-- Pinned transitive dependency: the version requested by Microsoft.Data.SqlClient has known vulnerabilities. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="mssql\*.sql" />
    <EmbeddedResource Include="mssql\grants\*.sql" />
  </ItemGroup>
</Project>